%% Metamodelo do MFAD v0 — gerado de src/mfad/domain/
%%
%% root          o agregado, raiz de tudo que a reconstrução produz
%% entity        tem identidade e é referenciada de fora por ela
%% relationship  relação reificada entre unidades, sem identidade
%% value         só existe como parte de outra coisa, comparada por valor
%% input         declaração do usuário, lida e não gerada
%% output        produzido por outro módulo, gravado à parte
%%
%% Losango cheio: composição. Tracejado: referência por IDENTIFICADOR,
%% nunca por ponteiro de objeto.
classDiagram
    direction TB

    class MicroFrontendArchitecture {
        <<root>>
        +str project
        +list~MicroFrontend~ microfrontends
        +list~Composition~ compositions
        +list~Navigation~ navigations
        +list~Communication~ communications
        +list~ApiCall~ api_calls
        +list~StateAccess~ state_accesses
        +Provenance provenance
        +microfrontend(id) MicroFrontend
        +fragments() list~Fragment~
        +screens() list~Screen~
    }

    class MicroFrontend {
        <<entity>>
        +str id
        +str directory
        +str entrypoint
        +list~str~ routes
        +str role
        +list~str~ mounts
        +list~Fragment~ fragments
        +list~Screen~ screens
        +CodeSize size
        +dict metadata
    }

    class Fragment {
        <<entity>>
        +str name
        +str microfrontend
        +str file
        +int line
        +id() str
    }

    class Screen {
        <<entity>>
        +str component
        +str microfrontend
        +str route
        +str route_expression
        +str file
        +int line
        +bool reachable
        +id() str
    }

    class CodeSize {
        <<value>>
        +int files
        +int lines
        +int code_lines
    }

    class Composition {
        <<relationship>>
        +str consumer
        +str provider
        +str fragment
        +str local_name
        +SourceLocation imported_at
        +list~RenderLocation~ renders
    }

    class RenderLocation {
        <<value>>
        +str file
        +int line
        +list~str~ props
        +list~str~ screens
    }

    class Navigation {
        <<relationship>>
        +str source
        +str target
        +str expression
        +str resolved_url
        +str match
        +SourceLocation at
    }

    class Communication {
        <<relationship>>
        +str source
        +str target
        +str mechanism
        +str channel
        +list~SourceLocation~ produced_at
        +list~SourceLocation~ consumed_at
        +bool directed
    }

    class ApiCall {
        <<relationship>>
        +str microfrontend
        +str method
        +str path
        +str match
        +str client
        +SourceLocation at
        +list~str~ screens
        +list~str~ fragments
    }

    class StateAccess {
        <<relationship>>
        +str microfrontend
        +str library
        +str path
        +SourceLocation at
    }

    class SourceLocation {
        <<value>>
        +str file
        +int line
        +str code
    }

    class Provenance {
        <<value>>
        +str schema
        +str tool
        +str generated_at
        +str reconstructor
        +list~SourceRepository~ sources
        +source(path) SourceRepository
    }

    class SourceRepository {
        <<value>>
        +str path
        +str remote
        +str commit
        +bool dirty
    }

    class AntiPattern {
        <<entity>>
        +str name
        +str description
        +str category
        +str reference
    }

    class AntiPatternDetection {
        <<output>>
        +str anti_pattern
        +str message
        +str dimension
        +str explanation
        +list~str~ subjects
        +list~SourceLocation~ locations
        +dict metadata
    }

    class CommunicationSpec {
        <<input>>
        +list~Mechanism~ mechanisms
    }

    class Mechanism {
        <<input>>
        +str name
        +str kind
        +ChannelOperation produce
        +ChannelOperation consume
    }

    class ChannelOperation {
        <<value>>
        +str module
        +str export
        +int channel_argument
    }

    MicroFrontendArchitecture *-- MicroFrontend
    MicroFrontendArchitecture *-- Composition
    MicroFrontendArchitecture *-- Navigation
    MicroFrontendArchitecture *-- Communication
    MicroFrontendArchitecture *-- ApiCall
    MicroFrontendArchitecture *-- StateAccess
    MicroFrontendArchitecture *-- Provenance

    MicroFrontend *-- Fragment
    MicroFrontend *-- Screen
    MicroFrontend *-- CodeSize

    Composition *-- SourceLocation : imported_at
    Composition *-- RenderLocation
    Navigation *-- SourceLocation : at
    Communication *-- SourceLocation : produced_at / consumed_at
    ApiCall *-- SourceLocation : at
    StateAccess *-- SourceLocation : at
    AntiPatternDetection *-- SourceLocation
    AntiPatternDetection ..> AntiPattern : anti_pattern
    Provenance *-- SourceRepository

    CommunicationSpec *-- Mechanism
    Mechanism *-- ChannelOperation : produce / consume

    Screen ..> MicroFrontend : microfrontend
    Fragment ..> MicroFrontend : microfrontend
    Composition ..> MicroFrontend : consumer / provider
    Navigation ..> MicroFrontend : source / target
    Communication ..> MicroFrontend : source / target
    ApiCall ..> MicroFrontend : microfrontend
    ApiCall ..> Screen : screens
    ApiCall ..> Fragment : fragments
    StateAccess ..> MicroFrontend : microfrontend
    RenderLocation ..> Screen : screens
    AntiPatternDetection ..> MicroFrontend : subjects
