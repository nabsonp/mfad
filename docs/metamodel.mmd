%% Metamodelo de arquitetura micro frontend.
%%
%% RECORTE das classes de src/damfe/domain/ — todas existem no código,
%% com os campos que elas têm de fato. Ficam de fora as peças do próprio
%% DAMFE, que continuam no código e não são conceitos da arquitetura
%% analisada: Provenance e SourceRepository (procedência da execução),
%% CommunicationSpec, Mechanism e ChannelOperation (configuração do
%% extrator). Por isso o campo `provenance` do agregado não aparece.
%%
%% Losango cheio: composição. A cardinalidade do lado do losango é
%% sempre 1: um value object pertence a um dono só.
%%
%% A cor vem do estereótipo, anotado em cada classe com `:::`. Os
%% estereótipos continuam escritos, para o diagrama sobreviver em
%% preto e branco.
%%
%% Nenhuma associação é ponteiro: o campo guarda o IDENTIFICADOR do
%% outro lado — `Screen.microfrontend` é "@org/mfe-checkout". É o que
%% permite serializar cada coleção num arquivo independente e recarregar
%% sem reconstruir grafo de objetos.
%%
%% Ficam fora do desenho as referências secundárias, que são contexto e
%% não estrutura: `ApiCall.screens`, `ApiCall.fragments` e
%% `RenderLocation.screens` guardam ids de tela e de fragmento.
classDiagram
    direction TB

    classDef root fill:#cfe3d4,stroke:#2d6a4f,color:#10291c
    classDef entity fill:#dce8f7,stroke:#36618e,color:#14263d
    classDef relationship fill:#fae3cd,stroke:#9c5f1c,color:#3d2206
    classDef access fill:#d8ece2,stroke:#2f6b50,color:#12301f
    classDef value fill:#ebe7f0,stroke:#6f5f8a,color:#271f33
    classDef external fill:#f3ecd8,stroke:#8a7430,color:#332c0f
    classDef output fill:#f7dede,stroke:#9c3a3a,color:#3d1414

    class MicroFrontendArchitecture:::root {
        <<root>>
        +str project
        +list~MicroFrontend~ microfrontends
        +list~Composition~ compositions
        +list~Navigation~ navigations
        +list~Communication~ communications
        +list~ApiCall~ api_calls
        +list~StateAccess~ state_accesses
    }

    class MicroFrontend:::entity {
        <<entity>>
        +str id
        +str directory
        +str entrypoint
        +list~str~ routes
        +str role
        +list~str~ mounts
        +list~Fragment~ fragments
        +list~Screen~ screens
        +CodeSize size
        +dict metadata
    }
    class Screen:::entity {
        <<entity>>
        +str component
        +str microfrontend
        +str route
        +str route_expression
        +str file
        +int line
        +bool reachable
    }
    class Fragment:::entity {
        <<entity>>
        +str name
        +str microfrontend
        +str file
        +int line
    }

    class Composition:::relationship {
        <<relationship>>
        +str consumer
        +str provider
        +str fragment
        +str local_name
        +SourceLocation imported_at
        +list~RenderLocation~ renders
    }
    class Navigation:::relationship {
        <<relationship>>
        +str source
        +str target
        +str expression
        +str resolved_url
        +str match
        +SourceLocation at
    }
    class Communication:::relationship {
        <<relationship>>
        +str source
        +str target
        +str mechanism
        +str channel
        +list~SourceLocation~ produced_at
        +list~SourceLocation~ consumed_at
        +bool directed
    }

    class ApiCall:::access {
        <<access>>
        +str microfrontend
        +str method
        +str path
        +str match
        +str client
        +SourceLocation at
        +list~str~ screens
        +list~str~ fragments
    }
    class StateAccess:::access {
        <<access>>
        +str microfrontend
        +str library
        +str path
        +SourceLocation at
    }

    class Endpoint:::external {
        <<external>>
        +str path
        +list~str~ methods
        +list~str~ microfrontends
    }

    class CodeSize:::value {
        <<value>>
        +int files
        +int lines
        +int code_lines
    }
    class SourceLocation:::value {
        <<value>>
        +str file
        +int line
        +str code
    }
    class RenderLocation:::value {
        <<value>>
        +str file
        +int line
        +list~str~ props
        +list~str~ screens
    }

    class AntiPattern:::entity {
        <<entity>>
        +str name
        +str description
        +str category
        +str reference
    }

    class AntiPatternDetection:::output {
        <<output>>
        +str anti_pattern
        +str message
        +str dimension
        +str explanation
        +list~str~ subjects
        +list~SourceLocation~ locations
        +dict metadata
    }

    MicroFrontendArchitecture "1" *-- "2..*" MicroFrontend : reúne
    MicroFrontendArchitecture "1" ..> "0..*" Endpoint : deriva das chamadas

    MicroFrontend "1" *-- "0..*" Screen : serve
    MicroFrontend "1" *-- "0..*" Fragment : expõe
    MicroFrontend "1" *-- "1" CodeSize

    Composition "0..*" --> "2" MicroFrontend : consumidor / provedor
    Navigation "0..*" --> "2" MicroFrontend : origem / destino
    Communication "0..*" --> "2" MicroFrontend : origem / destino
    ApiCall "0..*" --> "1" MicroFrontend : chamador
    ApiCall "0..*" --> "1" Endpoint : alvo
    StateAccess "0..*" --> "1" MicroFrontend
    AntiPatternDetection "0..*" --> "1..*" MicroFrontend : sujeitos

    Composition "1" *-- "1" SourceLocation : importado em
    Composition "1" *-- "0..*" RenderLocation : instanciado em
    Navigation "1" *-- "1" SourceLocation
    Communication "1" *-- "0..*" SourceLocation : produz / consome
    ApiCall "1" *-- "1" SourceLocation
    StateAccess "1" *-- "1" SourceLocation
    AntiPatternDetection "1" *-- "0..*" SourceLocation

    AntiPatternDetection "0..*" ..> "1" AntiPattern : instancia
    StateAccess "2..*" ..> "0..*" Communication : deriva aresta não dirigida
