%% Micro frontend architecture metamodel.
%%
%% A CUT of the classes in src/mfad/domain/ — all of them exist in the code,
%% with the fields they actually have. Left out are MFAD's own pieces,
%% which remain in the code but are not concepts of the analysed
%% architecture: Provenance and SourceRepository (provenance of the run),
%% CommunicationSpec, Mechanism and ChannelOperation (extractor
%% configuration). That is why the aggregate's `provenance` field does not appear.
%%
%% Filled diamond: composition. The cardinality on the diamond side is
%% always 1: a value object belongs to a single owner.
%%
%% The colour comes from the stereotype, annotated on each class with `:::`. The
%% stereotypes are still written out, so the diagram survives in
%% black and white.
%%
%% No association is a pointer: the field holds the IDENTIFIER of the
%% other side — `Screen.microfrontend` is "@org/mfe-checkout". That is what
%% allows serializing each collection to an independent file and reloading
%% without rebuilding an object graph.
%%
%% Secondary references are left out of the drawing, as they are context and
%% not structure: `ApiCall.screens`, `ApiCall.fragments` and
%% `RenderLocation.screens` hold screen and fragment ids.
classDiagram
    direction TB

    classDef root fill:#cfe3d4,stroke:#2d6a4f,color:#10291c
    classDef entity fill:#dce8f7,stroke:#36618e,color:#14263d
    classDef relationship fill:#fae3cd,stroke:#9c5f1c,color:#3d2206
    classDef access fill:#d8ece2,stroke:#2f6b50,color:#12301f
    classDef value fill:#ebe7f0,stroke:#6f5f8a,color:#271f33
    classDef external fill:#f3ecd8,stroke:#8a7430,color:#332c0f
    classDef output fill:#f7dede,stroke:#9c3a3a,color:#3d1414

    class MicroFrontendArchitecture:::root {
        <<root>>
        +str project
        +list~MicroFrontend~ microfrontends
        +list~Composition~ compositions
        +list~Navigation~ navigations
        +list~Communication~ communications
        +list~ApiCall~ api_calls
        +list~StateAccess~ state_accesses
    }

    class MicroFrontend:::entity {
        <<entity>>
        +str id
        +str directory
        +str entrypoint
        +list~str~ routes
        +str role
        +list~str~ mounts
        +list~Fragment~ fragments
        +list~Screen~ screens
        +CodeSize size
        +dict metadata
    }
    class Screen:::entity {
        <<entity>>
        +str component
        +str microfrontend
        +str route
        +str route_expression
        +str file
        +int line
        +bool reachable
    }
    class Fragment:::entity {
        <<entity>>
        +str name
        +str microfrontend
        +str file
        +int line
    }

    class Composition:::relationship {
        <<relationship>>
        +str consumer
        +str provider
        +str fragment
        +str local_name
        +SourceLocation imported_at
        +list~RenderLocation~ renders
    }
    class Navigation:::relationship {
        <<relationship>>
        +str source
        +str target
        +str expression
        +str resolved_url
        +str match
        +SourceLocation at
    }
    class Communication:::relationship {
        <<relationship>>
        +str source
        +str target
        +str mechanism
        +str channel
        +list~SourceLocation~ produced_at
        +list~SourceLocation~ consumed_at
        +bool directed
    }

    class ApiCall:::access {
        <<access>>
        +str microfrontend
        +str method
        +str path
        +str match
        +str client
        +SourceLocation at
        +list~str~ screens
        +list~str~ fragments
    }
    class StateAccess:::access {
        <<access>>
        +str microfrontend
        +str library
        +str path
        +SourceLocation at
    }

    class Endpoint:::external {
        <<external>>
        +str path
        +list~str~ methods
        +list~str~ microfrontends
    }

    class CodeSize:::value {
        <<value>>
        +int files
        +int lines
        +int code_lines
    }
    class SourceLocation:::value {
        <<value>>
        +str file
        +int line
        +str code
    }
    class RenderLocation:::value {
        <<value>>
        +str file
        +int line
        +list~str~ props
        +list~str~ screens
    }

    class AntiPattern:::entity {
        <<entity>>
        +str name
        +str description
        +str category
        +str reference
    }

    class AntiPatternDetection:::output {
        <<output>>
        +str anti_pattern
        +str message
        +str dimension
        +str explanation
        +list~str~ subjects
        +list~SourceLocation~ locations
        +dict metadata
    }

    MicroFrontendArchitecture "1" *-- "2..*" MicroFrontend : gathers
    MicroFrontendArchitecture "1" ..> "0..*" Endpoint : derived from the calls

    MicroFrontend "1" *-- "0..*" Screen : serves
    MicroFrontend "1" *-- "0..*" Fragment : exposes
    MicroFrontend "1" *-- "1" CodeSize

    Composition "0..*" --> "2" MicroFrontend : consumer / provider
    Navigation "0..*" --> "2" MicroFrontend : source / target
    Communication "0..*" --> "2" MicroFrontend : source / target
    ApiCall "0..*" --> "1" MicroFrontend : caller
    ApiCall "0..*" --> "1" Endpoint : target
    StateAccess "0..*" --> "1" MicroFrontend
    AntiPatternDetection "0..*" --> "1..*" MicroFrontend : subjects

    Composition "1" *-- "1" SourceLocation : imported at
    Composition "1" *-- "0..*" RenderLocation : instantiated at
    Navigation "1" *-- "1" SourceLocation
    Communication "1" *-- "0..*" SourceLocation : produces / consumes
    ApiCall "1" *-- "1" SourceLocation
    StateAccess "1" *-- "1" SourceLocation
    AntiPatternDetection "1" *-- "0..*" SourceLocation

    AntiPatternDetection "0..*" ..> "1" AntiPattern : instantiates
    StateAccess "2..*" ..> "0..*" Communication : derives undirected edge
